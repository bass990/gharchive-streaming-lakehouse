# Copy to .env. Defaults match docker-compose.yml.
KAFKA_BOOTSTRAP=127.0.0.1:19092
SCHEMA_REGISTRY=http://127.0.0.1:18081
TOPIC_EVENTS=gh.events.v1
TOPIC_PARTITIONS=6

LAKEHOUSE_BUCKET=gh-lakehouse
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse-local
S3_ENDPOINT=http://127.0.0.1:9010
ICEBERG_REST_URI=http://127.0.0.1:8182

PG_USER=gh
PG_PASSWORD=gh-local
PG_DB=gh
PG_DSN=postgresql://gh:gh-local@127.0.0.1:5434/gh
CONNECT_URL=http://127.0.0.1:8083

GHARCHIVE_BASE=https://data.gharchive.org
